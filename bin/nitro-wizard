#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
JAR="$PROJECT_ROOT/target/nitro-wizard.jar"

if [ ! -f "$JAR" ]; then
  echo "Jar not found: $JAR" >&2
  echo "Build it with: mvn -q -DskipTests package" >&2
  exit 1
fi

exec java -jar "$JAR" "$@"
